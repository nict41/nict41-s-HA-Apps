#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Parcel Tracker dashboard
# ==============================================================================

declare mailboxes_json
declare lookback_days
declare poll_interval_minutes
declare auto_archive_after_days
declare trusted_senders
declare ignore_senders
declare seventeentrack_api_key

mailboxes_json=$(bashio::config 'mailboxes' '[]')
lookback_days=$(bashio::config 'lookback_days')
poll_interval_minutes=$(bashio::config 'poll_interval_minutes')
auto_archive_after_days=$(bashio::config 'auto_archive_after_days')
trusted_senders=$(bashio::config 'trusted_senders')
ignore_senders=$(bashio::config 'ignore_senders')
seventeentrack_api_key=$(bashio::config 'seventeentrack_api_key')

export MAILBOXES_JSON="${mailboxes_json}"
export LOOKBACK_DAYS="${lookback_days}"
export POLL_INTERVAL_MINUTES="${poll_interval_minutes}"
export AUTO_ARCHIVE_AFTER_DAYS="${auto_archive_after_days}"
export TRUSTED_SENDERS="${trusted_senders}"
export IGNORE_SENDERS="${ignore_senders}"
export SEVENTEENTRACK_API_KEY="${seventeentrack_api_key}"

bashio::log.info "Starting Parcel Tracker dashboard on port 8000..."

cd /app || bashio::exit.nok "Could not change to /app directory"
exec python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
