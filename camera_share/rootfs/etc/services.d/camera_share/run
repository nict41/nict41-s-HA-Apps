#!/usr/bin/with-contenv bashio
# ==============================================================================
# Camera Share
#
# Reads app options into the environment and starts the public camera page.
#
# Note there is deliberately no HA_URL here: that name collides with other
# tooling in this stack. The app talks to Home Assistant over the Supervisor's
# internal proxy (http://supervisor/core/api) using SUPERVISOR_TOKEN, which
# the Supervisor injects because config.yaml asks for homeassistant_api.
# HA_API exists only as an override for development and tests.
# ==============================================================================

declare camera_entity
declare page_title
declare fps
declare access_key
declare max_viewers

camera_entity=$(bashio::config 'camera_entity')
page_title=$(bashio::config 'page_title')
fps=$(bashio::config 'fps')
access_key=$(bashio::config 'access_key')
max_viewers=$(bashio::config 'max_viewers')

export CAMERA_ENTITY="${camera_entity}"
export PAGE_TITLE="${page_title}"
export FPS="${fps}"
export ACCESS_KEY="${access_key}"
export MAX_VIEWERS="${max_viewers}"

bashio::log.info "Camera: ${camera_entity}"
bashio::log.info "Frame rate: up to ${fps} fps per viewer, ${max_viewers} viewer(s) max"

# Said here as well as in the app's own startup log, because this is the line
# that lands in the app log before anything else and the page is about to be
# published on the internet through a tunnel.
if bashio::var.has_value "${access_key}"; then
    bashio::log.info "Access key is set - the share link must carry ?key=<access key>"
else
    bashio::log.warning "No access key set - anyone who reaches this port can watch the camera"
fi

# The host port is whatever the Network tab says, which is NOT necessarily
# the default in config.yaml: an app that already existed on this machine
# (a local copy with the same slug, say) keeps the port mapping it already
# had, and anyone can change it. Getting this wrong means a Cloudflare
# tunnel pointed at a port nothing is listening on, so the app reports the
# real one rather than letting the docs be the source of truth.
#
# bashio 0.18 renamed every bashio::addon.* function to bashio::app.*, so
# both spellings are tried; if neither is available the app still starts
# and just says where to look instead.
declare host_port=""
declare fn
for fn in bashio::app.ports bashio::addon.ports; do
    if declare -F "${fn}" >/dev/null 2>&1; then
        host_port=$("${fn}" 2>/dev/null | jq -r '."8099/tcp" // empty' 2>/dev/null) || host_port=""
        bashio::var.has_value "${host_port}" && break
    fi
done

if bashio::var.has_value "${host_port}"; then
    bashio::log.info "Point the Cloudflare tunnel at http://<Home Assistant LAN IP>:${host_port}"
else
    bashio::log.info "Point the Cloudflare tunnel at the host port shown on this app's Network tab"
fi

bashio::log.info "Starting Camera Share on container port 8099..."

cd /app || bashio::exit.nok "Could not change to /app directory"
exec python3 -m uvicorn main:app --host 0.0.0.0 --port 8099
