#!/command/with-contenv bashio
# shellcheck shell=bash
#
# The God's Eye View dev server. It has to be the dev server rather than a
# built bundle: every live-data proxy (OpenSky, CelesTrak, CCTV, FIRMS,
# TomTom, Overpass, GBFS, adsb.lol, terrain) is registered as dev-server
# middleware upstream, so `vite build` + `vite preview` would drop them.

set -a
# shellcheck disable=SC1091
. /run/gev/gev.env
set +a

cd /opt/gods-eye-view || bashio::exit.nok "God's Eye View is not installed"

# Upstream's config, with its unmatched-API-route catch-all replaced by one
# that does not swallow the app itself. Home Assistant's ingress path is an
# /api path, so without this every request under the base answers
# {"error":"Unknown API route"} — see the file for the whole story.
# The CLI flag is `-c, --config <file>`. `configFile` is the name the JS API
# uses for the same thing and is NOT a CLI option — passing it aborts Vite
# before the server starts. The Dockerfile asserts the flag still exists.
readonly CONFIG="/opt/gods-eye-view/vite.config.ha.mjs"

base="$(cat /run/gev/base 2>/dev/null || true)"
if [ -n "${base}" ]; then
    bashio::log.info "Starting God's Eye View (port=4173, base=${base}/)"
    exec node node_modules/vite/bin/vite.js \
        --config "${CONFIG}" \
        --host 127.0.0.1 --port 4173 --strictPort --base "${base}/"
fi

bashio::log.info "Starting God's Eye View (port=4173)"
exec node node_modules/vite/bin/vite.js \
    --config "${CONFIG}" \
    --host 127.0.0.1 --port 4173 --strictPort
