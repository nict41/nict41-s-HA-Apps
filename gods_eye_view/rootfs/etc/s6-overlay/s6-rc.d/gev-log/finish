#!/command/with-contenv bashio
# shellcheck shell=bash

# Diagnostics are not worth taking the add-on down for: log the exit and let
# s6 restart the sink. Only `gev` and `nginx` halt the container.
if [[ ( "${1}" -eq 256 && "${2}" -eq 15 ) || "${1}" -eq 143 ]]; then
    # SIGTERM: the add-on is stopping, nothing is being restarted.
    exit 0
fi

bashio::log.warning "Client diagnostics sink exited (${1}/${2}); restarting"
