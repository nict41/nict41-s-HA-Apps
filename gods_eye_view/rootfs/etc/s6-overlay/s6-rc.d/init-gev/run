#!/command/with-contenv bashio
# shellcheck shell=bash
#
# Prepare everything the dev server and nginx need before either starts:
# persistent state under /data, provider keys from the add-on options, the
# ingress base path, the generated nginx server block, and the shim that
# nginx injects into index.html.

set -e

readonly GEV_HOME="/opt/gods-eye-view"
readonly RUN_DIR="/run/gev"
readonly WWW_DIR="${RUN_DIR}/www"
readonly ENV_FILE="${RUN_DIR}/gev.env"
readonly VITE_PORT=4173
readonly LOG_PORT=4180
readonly AUTH_PORT=4181
readonly AUTH_ENV_FILE="${RUN_DIR}/auth.env"
# Ingress gets its own listener so the published one can carry a login
# without Home Assistant ever seeing it.
readonly INGRESS_PORT=8099
readonly LISTEN_PORT=8037

mkdir -p "${RUN_DIR}" "${WWW_DIR}" /etc/nginx/servers /data/cache /data/logs
# nginx workers drop to an unprivileged user, so the generated shim has to sit
# on a path they can traverse and read.
chmod 755 "${RUN_DIR}" "${WWW_DIR}"

# ── Persistent app state ─────────────────────────────────────────────────────
# The app writes three things next to its own checkout, all of which would be
# lost on every add-on update if left in the image:
#   .env        keys saved by the in-app POWER UP panel
#   .gev-cache  CelesTrak / FIRMS / TomTom / terrain response caches
#   .gev-logs   voice + realtime debug logs
if [ ! -f /data/.env ]; then
    printf '# Provider keys added from inside God'"'"'s Eye View.\n' > /data/.env
fi
chmod 600 /data/.env

for link in .env:/data/.env .gev-cache:/data/cache .gev-logs:/data/logs; do
    rm -rf "${GEV_HOME}/${link%%:*}"
    ln -sfn "${link#*:}" "${GEV_HOME}/${link%%:*}"
done

# ── Ingress base path ────────────────────────────────────────────────────────
# Home Assistant serves the add-on under /api/hassio_ingress/<token>/ and
# strips that prefix before the request reaches us. Vite is started with it as
# its --base so every URL it emits carries the prefix the browser needs.
gev_base=""
if ingress_entry="$(bashio::addon.ingress_entry 2>/dev/null)" \
        && [ -n "${ingress_entry}" ] && [ "${ingress_entry}" != "null" ]; then
    gev_base="${ingress_entry%/}"
    bashio::log.info "Ingress path: ${gev_base}"
else
    bashio::log.warning "Could not read the ingress path from the Supervisor."
    bashio::log.warning "The sidebar panel will not work; use direct access on port ${LISTEN_PORT}."
fi
printf '%s' "${gev_base}" > "${RUN_DIR}/base"

# ── Provider keys and tuning ─────────────────────────────────────────────────
: > "${ENV_FILE}"
chmod 600 "${ENV_FILE}"

# Only non-empty values are written. An exported-but-empty variable would stop
# the app's own loadEnv from ever falling back to a key saved in /data/.env.
write_env() {
    local name="${1}"
    local value="${2}"
    local file="${3:-${ENV_FILE}}"
    [ -n "${value}" ] || return 0
    printf "%s='%s'\n" "${name}" "$(printf '%s' "${value}" | sed "s/'/'\\\\''/g")" >> "${file}"
}

config_value() {
    if bashio::config.has_value "${1}"; then
        bashio::config "${1}"
    fi
}

# HOST is what the upstream config reads to decide `allowedHosts`; setting it
# to 0.0.0.0 accepts the Host header nginx forwards. The actual bind address
# stays loopback-only — that is passed on the command line, which wins.
write_env HOST "0.0.0.0"
write_env PORT "${VITE_PORT}"

write_env CESIUM_ION_TOKEN "$(config_value 'cesium_ion_token')"
write_env GOOGLE_MAPS_API_KEY "$(config_value 'google_maps_api_key')"
write_env OPENAI_API_KEY "$(config_value 'openai_api_key')"
write_env AISSTREAM_API_KEY "$(config_value 'aisstream_api_key')"
write_env FIRMS_MAP_KEY "$(config_value 'firms_map_key')"
write_env TOMTOM_API_KEY "$(config_value 'tomtom_api_key')"
write_env LL2_API_TOKEN "$(config_value 'll2_api_token')"

opensky_id="$(config_value 'opensky_client_id')"
opensky_secret="$(config_value 'opensky_client_secret')"
write_env OPENSKY_CLIENT_ID "${opensky_id}"
write_env OPENSKY_CLIENT_SECRET "${opensky_secret}"
if [ -n "${opensky_id}" ] && [ -n "${opensky_secret}" ]; then
    write_env OPENSKY_AUTH_MODE "oauth"
fi

# extra_env is the escape hatch for the ~30 further variables the upstream
# .env.example documents (voice model, CCTV sources, rate limits, budgets).
while IFS= read -r entry; do
    [ -n "${entry}" ] || continue
    write_env "${entry%%=*}" "${entry#*=}"
done < <(jq -r '(.extra_env // [])[]' /data/options.json)

key_count="$(grep -c '_API_KEY=\|_TOKEN=\|_KEY=\|_SECRET=' "${ENV_FILE}" || true)"
bashio::log.info "Provider keys supplied by add-on options: ${key_count}"
bashio::log.info "Keys set here appear as externally managed in the app's POWER UP panel."

# ── Ingress shim ─────────────────────────────────────────────────────────────
if bashio::config.true 'client_diagnostics'; then
    diagnostics=1
    bashio::log.info "Client diagnostics on: browser errors and stalls are logged here as [client] lines"
else
    diagnostics=0
fi

sed -e "s|__GEV_BASE__|${gev_base}|" -e "s|__GEV_DIAG__|${diagnostics}|" \
    /opt/gev-ha/ingress-shim.js > "${WWW_DIR}/ingress-shim.js"
chmod 644 "${WWW_DIR}/ingress-shim.js"

# ── Session login ────────────────────────────────────────────────────────────
# Ingress is authenticated by Home Assistant, so a login there would only ask
# the same person twice. It guards the PUBLISHED port instead — the one you
# would put behind a tunnel. The two are separate nginx listeners rather than
# one listener with a check, because any header a check could read is one a
# public client can forge.
auth_user="$(config_value 'auth_username')"
auth_pass="$(config_value 'auth_password')"
auth_enabled=false

if [ -n "${auth_user}" ] && [ -n "${auth_pass}" ]; then
    auth_enabled=true

    # Persistent signing key: sessions survive a restart. It is combined with
    # the credentials at use, so changing either expires every session.
    if [ ! -s /data/session.key ]; then
        head -c 32 /dev/urandom > /data/session.key
    fi
    chmod 600 /data/session.key

    : > "${AUTH_ENV_FILE}"
    chmod 600 "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_USERNAME "${auth_user}" "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_PASSWORD "${auth_pass}" "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_SESSION_DAYS "$(config_value 'auth_session_days')" "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_PORT "${AUTH_PORT}" "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_KEY_FILE "/data/session.key" "${AUTH_ENV_FILE}"

    bashio::log.info "Session login enabled on port ${LISTEN_PORT} for user '${auth_user}'"
else
    : > "${AUTH_ENV_FILE}"
    chmod 600 "${AUTH_ENV_FILE}"
    write_env GEV_AUTH_PORT "${AUTH_PORT}" "${AUTH_ENV_FILE}"
    bashio::log.warning "No login configured: port ${LISTEN_PORT} is open to anyone who can reach it."
    bashio::log.warning "Set auth_username and auth_password before exposing it beyond your LAN."
fi

normalise_rewrites=""
if [ -n "${gev_base}" ]; then
    # Direct callers send the base-prefixed URLs the app emits; ingress has
    # already stripped its own prefix. Reduce both to the unprefixed form.
    normalise_rewrites="$(printf '    rewrite "^%s$" / last;\n    rewrite "^%s(/.*)$" $1 last;\n' "${gev_base}" "${gev_base}")"
fi

rm -f /etc/nginx/servers/gev.conf

# ── nginx ────────────────────────────────────────────────────────────────────
# One set of locations, served by both listeners.
cat > "${RUN_DIR}/locations.conf" <<NGINX
${normalise_rewrites}
    location = /__gev_ha/ingress-shim.js {
        alias ${WWW_DIR}/ingress-shim.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
    }

    # Diagnostics the shim reports from the browser, printed to the add-on log.
    location = /__gev_ha/log {
        proxy_pass http://127.0.0.1:${LOG_PORT};
        proxy_http_version 1.1;
        access_log off;
    }

    # The app's own API routes are registered on the dev server ahead of Vite's
    # base middleware, so they must reach it without the base prefix.
    location /api/ {
        proxy_pass http://127.0.0.1:${VITE_PORT};
        include /etc/nginx/gev-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:${VITE_PORT}${gev_base}\$uri\$is_args\$gev_args;
        include /etc/nginx/gev-proxy.conf;

        # sub_filter cannot rewrite a compressed body.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        sub_filter "</head>" "<script src=\"${gev_base}/__gev_ha/ingress-shim.js\"></script></head>";
    }
NGINX
chmod 644 "${RUN_DIR}/locations.conf"

# Ingress listener. Unpublished, reachable only by the Supervisor, and never
# carrying the login — Home Assistant has already authenticated the caller.
cat > /etc/nginx/servers/gev-ingress.conf <<NGINX
server {
    listen ${INGRESS_PORT};
    server_name _;
    client_max_body_size 64m;

    include ${RUN_DIR}/locations.conf;
}
NGINX

# Published listener.
if [ "${auth_enabled}" = true ]; then
    cat > /etc/nginx/servers/gev-public.conf <<NGINX
upstream gev_auth {
    server 127.0.0.1:${AUTH_PORT};
    keepalive 8;
}

server {
    listen ${LISTEN_PORT} default_server;
    server_name _;
    client_max_body_size 64m;

    auth_request /__gev_ha/auth;
    error_page 401 = @gev_login;

    location @gev_login {
        return 302 /__gev_ha/login?next=\$request_uri;
    }

    location = /__gev_ha/auth {
        internal;
        auth_request off;
        proxy_pass http://gev_auth/verify;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    location ^~ /__gev_ha/login {
        auth_request off;
        proxy_pass http://gev_auth;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$gev_proto;
    }

    location ^~ /__gev_ha/logout {
        auth_request off;
        proxy_pass http://gev_auth;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Forwarded-Proto \$gev_proto;
    }

    include ${RUN_DIR}/locations.conf;
}
NGINX
else
    cat > /etc/nginx/servers/gev-public.conf <<NGINX
server {
    listen ${LISTEN_PORT} default_server;
    server_name _;
    client_max_body_size 64m;

    include ${RUN_DIR}/locations.conf;
}
NGINX
fi


nginx -t -q

# ── Outbound reachability ────────────────────────────────────────────────────
# Logged once at start. A DNS sink or a firewall that DROPs rather than REJECTs
# makes the app look like it is hanging, with nothing to distinguish it from a
# bug in here — so say plainly whether this container can reach the outside.
# Never fatal: the app is useful on cached and local data alone.
probe() {
    local label="${1}"
    local url="${2}"
    local code
    if code="$(curl -sS -o /dev/null -m 8 -w '%{http_code}' "${url}" 2>/dev/null)" \
            && [ "${code}" != "000" ]; then
        bashio::log.info "Reachability: ${label} OK (HTTP ${code})"
    else
        bashio::log.warning "Reachability: ${label} FAILED — no response within 8s"
    fi
}

probe "Esri basemap" "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer?f=pjson"
probe "CelesTrak" "https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle"

bashio::log.info "Configuration written; starting God's Eye View"
