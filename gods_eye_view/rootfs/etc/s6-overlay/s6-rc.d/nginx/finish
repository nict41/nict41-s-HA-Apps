#!/command/with-contenv bashio
# shellcheck shell=bash

declare exit_code=${1}
declare signal=${2}

# A requested stop arrives as SIGTERM. nginx handles it as a fast shutdown
# and exits 0 rather than dying of the signal, so 0 is what a clean stop looks
# like here; 256/15 is kept in case it is ever killed before installing its
# handlers. Neither is a crash. Let s6-overlay's own shutdown finish instead
# of forcing a halt here: halting from a finish script during shutdown races
# the other services' finish scripts for the container's exit code.
if [[ ( "${exit_code}" -eq 256 && "${signal}" -eq 15 ) || "${exit_code}" -eq 0 ]]; then
    bashio::log.info "Nginx stopped"
    exit 0
fi

if [[ "${exit_code}" -eq 256 ]]; then
    exit_code=$((128 + signal))
fi

bashio::log.warning "Nginx exited with code ${exit_code}, stopping add-on"
echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
