#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Pantry Tracker app
# ==============================================================================

declare notify_service
declare notify_days_before
declare notify_repeat_hours
declare check_interval_hours
declare vision_api_base
declare vision_api_key
declare vision_model

notify_service=$(bashio::config 'notify_service')
notify_days_before=$(bashio::config 'notify_days_before')
notify_repeat_hours=$(bashio::config 'notify_repeat_hours')
check_interval_hours=$(bashio::config 'check_interval_hours')
vision_api_base=$(bashio::config 'vision_api_base')
vision_api_key=$(bashio::config 'vision_api_key')
vision_model=$(bashio::config 'vision_model')

export NOTIFY_SERVICE="${notify_service}"
export NOTIFY_DAYS_BEFORE="${notify_days_before}"
export NOTIFY_REPEAT_HOURS="${notify_repeat_hours}"
export CHECK_INTERVAL_HOURS="${check_interval_hours}"
export VISION_API_BASE="${vision_api_base}"
export VISION_API_KEY="${vision_api_key}"
export VISION_MODEL="${vision_model}"

bashio::log.info "Starting Pantry Tracker on port 8000..."

cd /app || bashio::exit.nok "Could not change to /app directory"
exec python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
